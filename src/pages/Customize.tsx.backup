    ]
  },
  {
    id: "food",
    name: "Food Pack",
    icon: "🍕",
    stickers: [
      { id: "f1", emoji: "🍕", name: "Pizza" },
      { id: "f2", emoji: "🍔", name: "Burger" },
      { id: "f3", emoji: "🌮", name: "Taco" },
      { id: "f4", emoji: "🍩", name: "Donut" },
      { id: "f5", emoji: "🍦", name: "Ice Cream" },
      { id: "f6", emoji: "🍰", name: "Cake" },
      { id: "f7", emoji: "☕", name: "Coffee" },
      { id: "f8", emoji: "🍺", name: "Beer" },
    ]
  }
];

const Customize = () => {
  const [selectedTshirtColor, setSelectedTshirtColor] = useState(tshirtColors[0]);
  const [selectedTshirtType, setSelectedTshirtType] = useState(tshirtTypes[0]);
  const [tshirtView, setTshirtView] = useState<'front' | 'back'>('front');
  const [designElements, setDesignElements] = useState<DesignElement[]>([]);
  const [selectedElement, setSelectedElement] = useState<string | null>(null);
  const [canvasZoom, setCanvasZoom] = useState(100);
  const [isMobile, setIsMobile] = useState(false);
  const [history, setHistory] = useState<HistoryState[]>([]);
  const [historyIndex, setHistoryIndex] = useState(-1);
  const [isProcessingImage, setIsProcessingImage] = useState(false);
  const [showQuickActions, setShowQuickActions] = useState(false);
  const [showCropTool, setShowCropTool] = useState(false);
  const [cropElement, setCropElement] = useState<DesignElement | null>(null);

  useEffect(() => {
    const checkMobile = () => setIsMobile(window.innerWidth < 1024);
    checkMobile();
    window.addEventListener("resize", checkMobile);
    return () => window.removeEventListener("resize", checkMobile);
  }, []);

  useEffect(() => {
    const initialState: HistoryState = {
      elements: [],
      selectedElement: null,
      timestamp: Date.now(),
    };
    setHistory([initialState]);
    setHistoryIndex(0);
  }, []);

  const saveToHistory = useCallback(() => {
    const newState: HistoryState = {
      elements: [...designElements],
      selectedElement,
      timestamp: Date.now(),
    };

    const newHistory = history.slice(0, historyIndex + 1);
    newHistory.push(newState);

    if (newHistory.length > 50) {
      newHistory.shift();
    } else {
      setHistoryIndex(historyIndex + 1);
    }

    setHistory(newHistory);
  }, [designElements, selectedElement, history, historyIndex]);

  const undo = () => {
    if (historyIndex > 0) {
      const previousState = history[historyIndex - 1];
      setDesignElements(previousState.elements);
      setSelectedElement(previousState.selectedElement);
      setHistoryIndex(historyIndex - 1);
    }
  };

  const redo = () => {
    if (historyIndex < history.length - 1) {
      const nextState = history[historyIndex + 1];
      setDesignElements(nextState.elements);
      setSelectedElement(nextState.selectedElement);
      setHistoryIndex(historyIndex + 1);
    }
  };

  const generateId = () =>
    `element_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;

  const addTextElement = (text: string, font: string, size: number, color: string) => {
    if (!text.trim()) return;

    const newElement: DesignElement = {
      id: generateId(),
      type: "text",
      content: text,
      font,
      size,
      color,
      x: 100 + Math.random() * 50,
      y: 100 + Math.random() * 50,
      rotation: 0,
      opacity: 1,
      visible: true,
      locked: false,
    };

    setDesignElements([...designElements, newElement]);
    saveToHistory();
  };

  const addTemplate = (template: Template) => {
    const newElement: DesignElement = {
      id: generateId(),
      type: "template",
      template,
      x: 80 + Math.random() * 40,
      y: 80 + Math.random() * 40,
      width: 150,
      height: 150,
      rotation: 0,
      opacity: 1,
      visible: true,
      locked: false,
    };

    setDesignElements([...designElements, newElement]);
    saveToHistory();
  };

  const addSticker = (sticker: { id: string; emoji: string; name: string }) => {
    const newElement: DesignElement = {
      id: generateId(),
      type: "sticker",
      content: sticker.emoji,
      font: "Arial",
      size: 48,
      color: "#000000",
      x: 80 + Math.random() * 60,
      y: 80 + Math.random() * 60,
      rotation: 0,
      opacity: 1,
      visible: true,
      locked: false,
    };

    setDesignElements([...designElements, newElement]);
    saveToHistory();
  };

  const importFromGallery = () => {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = 'image/*';
    input.multiple = true;
    input.onchange = (e) => {
      const files = (e.target as HTMLInputElement).files;
      if (files) {
        Array.from(files).forEach(file => {
          handleImageUpload({ target: { files: [file] } } as any);
        });
      }
    };
    input.click();
  };

  const importFromCamera = () => {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = 'image/*';
    input.capture = 'environment';
    input.onchange = (e) => {
      const files = (e.target as HTMLInputElement).files;
      if (files && files[0]) {
        handleImageUpload({ target: { files: [files[0]] } } as any);
      }
    };
    input.click();
  };

  const removeBackground = async (imageFile: File): Promise<string> => {
    return new Promise((resolve) => {
      const canvas = document.createElement("canvas");
      const ctx = canvas.getContext("2d");
      const img = new Image();

      img.onload = () => {
        canvas.width = img.width;
        canvas.height = img.height;
        ctx?.drawImage(img, 0, 0);

        if (!ctx) {
          resolve(URL.createObjectURL(imageFile));
          return;
        }

        const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
        const data = imageData.data;

        const cornerPixel = [data[0], data[1], data[2]];
        const threshold = 30;

        for (let i = 0; i < data.length; i += 4) {
          const r = data[i];
          const g = data[i + 1];
          const b = data[i + 2];

          const diff =
            Math.abs(r - cornerPixel[0]) +
            Math.abs(g - cornerPixel[1]) +
            Math.abs(b - cornerPixel[2]);

          if (diff < threshold) {
            data[i + 3] = 0;
          }
        }

        ctx.putImageData(imageData, 0, 0);
        resolve(canvas.toDataURL("image/png"));
      };

      img.src = URL.createObjectURL(imageFile);
    });
  };

  const handleImageUpload = async (file: File) => {
    if (!file) return;

    setIsProcessingImage(true);

    try {
      const imageUrl = await removeBackground(file);

      const newElement: DesignElement = {
        id: generateId(),
        type: "image",
        imageUrl,
        x: 80 + Math.random() * 40,
        y: 80 + Math.random() * 40,
        width: 120,
        height: 120,
        rotation: 0,
        opacity: 1,
        visible: true,
        locked: false,
      };

      setDesignElements([...designElements, newElement]);
      saveToHistory();
    } catch (error) {
      console.error("Error processing image:", error);
    } finally {
      setIsProcessingImage(false);
    }
  };

  const handleCrop = (elementId: string, cropData: { x: number; y: number; width: number; height: number }) => {
    const element = designElements.find(el => el.id === elementId);
    if (!element || element.type !== 'image') return;

    // In a real implementation, you would crop the actual image
    // For now, we'll just update the element dimensions
    updateElement(elementId, {
      width: cropData.width,
      height: cropData.height,
    });

    setShowCropTool(false);
    setCropElement(null);
    saveToHistory();
  };

  const openCropTool = (elementId: string) => {
    const element = designElements.find(el => el.id === elementId);
    if (element && element.type === 'image') {
      setCropElement(element);
      setShowCropTool(true);
    }
  };

  const deleteElement = (elementId: string) => {
    setDesignElements(designElements.filter((el) => el.id !== elementId));
    if (selectedElement === elementId) {
      setSelectedElement(null);
    }
    saveToHistory();
  };

  const duplicateElement = (elementId: string) => {
    const element = designElements.find((el) => el.id === elementId);
    if (!element) return;

    const newElement: DesignElement = {
      ...element,
      id: generateId(),
      x: element.x + 20,
      y: element.y + 20,
    };

    setDesignElements([...designElements, newElement]);
    saveToHistory();
  };

  const toggleElementVisibility = (elementId: string) => {
    setDesignElements(
      designElements.map((el) =>
        el.id === elementId ? { ...el, visible: !el.visible } : el,
      ),
    );
  };

  const updateElement = useCallback(
    (elementId: string, updates: Partial<DesignElement>) => {
      setDesignElements(
        designElements.map((el) =>
          el.id === elementId ? { ...el, ...updates } : el,
        ),
      );
    },
    [designElements],
  );

  const saveDesign = () => {
    const designData = {
      tshirtColor: selectedTshirtColor,
      tshirtType: selectedTshirtType,
      elements: designElements,
      timestamp: Date.now(),
    };

    localStorage.setItem("saved_design", JSON.stringify(designData));
    alert("Design saved successfully!");
  };

  const shareDesign = async () => {
    const designData = {
      tshirtColor: selectedTshirtColor,
      tshirtType: selectedTshirtType,
      elements: designElements,
    };

    try {
      await navigator.clipboard.writeText(JSON.stringify(designData));
      alert("Design link copied to clipboard!");
    } catch (error) {
      console.error("Error sharing design:", error);
      alert("Error sharing design. Please try again.");
    }
  };

  const exportDesign = () => {
    const canvas = canvasRef.current;
    if (!canvas) return;

    const link = document.createElement("a");
    link.download = "my-tshirt-design.png";
    link.href = canvas.toDataURL();
    link.click();
  };

  // Quick Actions Component
  const QuickActions = () => {
    const actions = [
      { icon: Undo, action: undo, disabled: historyIndex <= 0, label: "Undo" },
      {
        icon: Redo,
        action: redo,
        disabled: historyIndex >= history.length - 1,
        label: "Redo",
      },
      {
        icon: ZoomIn,
        action: () => setCanvasZoom(Math.min(200, canvasZoom + 10)),
        label: "Zoom In",
      },
      {
        icon: ZoomOut,
        action: () => setCanvasZoom(Math.max(50, canvasZoom - 10)),
        label: "Zoom Out",
      },
      { icon: Save, action: saveDesign, label: "Save" },
      { icon: Share2, action: shareDesign, label: "Share" },
    ];

    return (
      <div className="fixed bottom-6 left-6 z-40">
        <div className="relative">
          {/* Quick action buttons - arranged in a circle */}
          {showQuickActions && (
            <div className="absolute bottom-16 left-0 transition-all duration-300">
              {actions.map((action, index) => {
                const angle = index * 60 - 90; // 60 degrees apart, starting from top
                const radius = 80;
                const x = Math.cos((angle * Math.PI) / 180) * radius;
                const y = Math.sin((angle * Math.PI) / 180) * radius;

                return (
                  <Button
                    key={index}
                    size="icon"
                    variant="default"
                    disabled={action.disabled}
                    onClick={action.action}
                    className="absolute w-12 h-12 rounded-full shadow-lg bg-primary hover:bg-primary/90 transition-all duration-200"
                    style={{
                      left: `${x}px`,
                      top: `${y}px`,
                      animation: `fadeInUp 0.3s ease-out ${index * 0.1}s both`,
                    }}
                    title={action.label}
                  >
                    <action.icon className="h-5 w-5" />
                  </Button>
                );
              })}
            </div>
          )}

          {/* Main FAB */}
          <Button
            size="icon"
            className="w-16 h-16 rounded-full shadow-xl bg-primary hover:bg-primary/90"
            onClick={() => setShowQuickActions(!showQuickActions)}
          >
            {showQuickActions ? (
              <X className="h-6 w-6" />
            ) : (
              <Plus className="h-6 w-6" />
            )}
          </Button>
        </div>
      </div>
    );
  };

  // Mobile layout for smaller screens
  if (isMobile) {
    return (
      <div className="min-h-screen bg-background flex flex-col">
        {/* Mobile Header */}
        <div className="glass-card border-b border-card-border px-4 py-3">
          <h1 className="text-lg font-bold text-center">Meme T-Shirt Studio</h1>
        </div>

        {/* Main Content Area with T-shirt on left, panels on right */}
        <div className="flex-1 flex">
          {/* T-shirt Canvas Area */}
          <div className="flex-1 p-4 bg-gradient-to-br from-gray-50 to-gray-100 dark:from-gray-900 dark:to-gray-800 overflow-hidden">
            <div className="h-full flex flex-col items-center justify-center">
              <TshirtCanvas 
                color={selectedTshirtColor.value}
                elements={designElements}
                selectedElement={selectedElement}
                onElementUpdate={updateElement}
              />
            </div>
          </div>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-gray-50 dark:bg-gray-900 flex">
      {/* WhatsApp Notification */}
      <WhatsAppNotification />
      
      {/* Main Canvas Area */}
      <div className="flex-1 flex flex-col items-center justify-center p-8 bg-gradient-to-br from-gray-50 to-gray-100 dark:from-gray-900 dark:to-gray-800">
        {/* T-shirt Display */}
        <div className="relative">
          <RealisticTshirt
            color={selectedTshirtColor}
            type={selectedTshirtType}
            view={tshirtView}
            size="large"
            className="transition-all duration-300 hover:scale-105"
          />
          
          {/* Design Elements Overlay */}
          <div className="absolute inset-0 pointer-events-none">
            {designElements.map((element) => (
              <div
                key={element.id}
                className={`absolute pointer-events-auto cursor-move ${
                  selectedElement?.id === element.id ? 'ring-2 ring-blue-500' : ''
                }`}
                style={{
                  left: `${element.x}px`,
                  top: `${element.y}px`,
                  transform: `rotate(${element.rotation || 0}deg) scale(${canvasZoom})`,
                  opacity: element.opacity || 1,
                  display: element.visible !== false ? 'block' : 'none'
                }}
                onClick={() => setSelectedElement(element)}
              >
                {element.type === 'text' && (
                  <div
                    style={{
                      fontSize: `${element.fontSize || 16}px`,
                      fontFamily: element.fontFamily || 'Arial',
                      color: element.color || selectedTshirtColor.textColor,
                      fontWeight: element.fontWeight || 'normal',
                      fontStyle: element.fontStyle || 'normal',
                      textAlign: element.textAlign || 'left'
                    }}
                  >
                    {element.content}
                  </div>
                )}
                {element.type === 'image' && (
                  <img
                    src={element.content}
                    alt="Design element"
                    style={{
                      width: `${element.width || 100}px`,
                      height: `${element.height || 100}px`
                    }}
                  />
                )}
                {element.type === 'sticker' && (
                  <div
                    style={{
                      fontSize: `${element.size || 24}px`,
                      color: element.color || selectedTshirtColor.textColor
                    }}
                  >
                    {element.content}
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
        
        {/* Canvas Controls */}
        <div className="mt-6 flex items-center space-x-4">
          <Button
            variant="outline"
            size="sm"
            onClick={() => setCanvasZoom(Math.max(0.5, canvasZoom - 0.1))}
          >
            <ZoomOut className="w-4 h-4" />
          </Button>
          <span className="text-sm text-gray-600 dark:text-gray-400">
            {Math.round(canvasZoom * 100)}%
          </span>
          <Button
            variant="outline"
            size="sm"
            onClick={() => setCanvasZoom(Math.min(2, canvasZoom + 0.1))}
          >
            <ZoomIn className="w-4 h-4" />
          </Button>
          <Button
            variant="outline"
            size="sm"
            onClick={() => setCanvasZoom(1)}
          >
            Reset
          </Button>
        </div>
      </div>

      {/* Photoshop-style Panel */}
      <PhotoshopPanel
        designElements={designElements}
        selectedElement={selectedElement}
        onElementUpdate={updateElement}
        onElementDelete={deleteElement}
        onElementDuplicate={duplicateElement}
        onElementVisibilityToggle={toggleElementVisibility}
        onAddText={addTextElement}
        onAddSticker={addSticker}
        onAddTemplate={addTemplate}
        onImageUpload={handleImageUpload}
        selectedTshirtColor={selectedTshirtColor}
        selectedTshirtType={selectedTshirtType}
        onTshirtColorChange={setSelectedTshirtColor}
        onTshirtTypeChange={setSelectedTshirtType}
        tshirtColors={tshirtColors}
        tshirtTypes={tshirtTypes}
        templates={templates}
        stickerPacks={stickerPacks}
      />

      {/* Quick Actions FAB */}
      <QuickActions />

      {/* Crop Tool Modal */}
      {showCropTool && cropElement && (
        <CropTool
          element={cropElement}
          onCrop={handleCrop}
          onCancel={() => {
            setShowCropTool(false);
            setCropElement(null);
          }}
        />
      )}

      {/* Bottom Action Bar */}
      <div className="fixed bottom-0 left-0 right-80 bg-white dark:bg-gray-900 border-t border-gray-200 dark:border-gray-700 p-4 z-30">
        <div className="flex items-center justify-between">
          <div className="flex items-center gap-4">
            <div className="text-sm text-gray-600 dark:text-gray-400">
              {designElements.length} elements • Zoom: {canvasZoom}%
            </div>
          </div>
          
          <div className="flex items-center gap-2">
            <Button variant="outline" onClick={exportDesign}>
              <Download className="h-4 w-4 mr-2" />
              Export
            </Button>
            <Button className="bg-primary hover:bg-primary/90">
              Add to Cart - TZS {selectedTshirtType.price.toLocaleString()}
            </Button>
          </div>
        </div>
      </div>
    </div>
  );
};

  // Right Panel Component
  const RightPanel = () => {
    const panels = [
      { id: "style", title: "Style", icon: Palette },
      { id: "layers", title: "Layers", icon: Layers },
      { id: "text", title: "Text", icon: Type },
      { id: "stickers", title: "Stickers", icon: Sticker },
      { id: "templates", title: "Memes", icon: ImageIcon },
      { id: "media", title: "Media", icon: FileImage },
      { id: "properties", title: "Properties", icon: Settings },
    ];

    return (
      <div
        className="fixed top-0 right-0 h-full bg-background border-l border-border shadow-xl transition-all duration-300 ease-in-out z-40"
        style={{ width: `${rightPanelWidth}px` }}
      >
        <div className="flex flex-col h-full">
          {/* Panel Header */}
          <div className="p-4 border-b border-border">
            <div className="flex items-center justify-between">
              <h2 className="text-lg font-semibold">Design Tools</h2>
              <div className="flex gap-2">
                <Button
                  variant="ghost"
                  size="icon"
                  onClick={() =>
                    setRightPanelWidth(rightPanelWidth === 320 ? 450 : 320)
                  }
                >
                  <Move className="h-4 w-4" />
                </Button>
              </div>
            </div>
          </div>

          {/* Panel Navigation */}
          <div className="border-b border-border">
            <div className="flex flex-wrap gap-1 p-2">
              {panels.map((panel) => (
                <Button
                  key={panel.id}
                  variant={expandedPanel === panel.id ? "default" : "ghost"}
                  size="sm"
                  onClick={() =>
                    setExpandedPanel(expandedPanel === panel.id ? "" : panel.id)
                  }
                  className="flex items-center gap-2"
                >
                  <panel.icon className="h-4 w-4" />
                  <span className="text-xs">{panel.title}</span>
                </Button>
              ))}
            </div>
          </div>

          {/* Panel Content */}
          <div className="flex-1 overflow-y-auto p-4">
            {expandedPanel === "style" && (
              <div className="space-y-6">
                {/* T-shirt Type Selector */}
                <TshirtTypeSelector
                  selectedType={selectedTshirtType}
                  onTypeSelect={setSelectedTshirtType}
                />

                {/* T-shirt Color Selector */}
                <div className="space-y-2">
                  <h3 className="text-sm font-medium">T-shirt Color</h3>
                  <div className="flex flex-wrap gap-2">
                    {tshirtColors.map((color) => (
                      <button
                        key={color.name}
                        className={`w-8 h-8 rounded-full border-2 ${
                          selectedTshirtColor.name === color.name 
                            ? 'border-primary' 
                            : 'border-gray-300'
                        }`}
                        style={{ backgroundColor: color.value }}
                        onClick={() => setSelectedTshirtColor(color)}
                        title={color.name}
                      />
                    ))}
                  </div>
                </div>

                {/* T-shirt View Toggle */}
                <TshirtViewToggle
                  currentView={tshirtView}
                  onViewChange={setTshirtView}
                />

                {/* Preview */}
                <div className="border border-gray-200 dark:border-gray-700 rounded-lg p-4">
                  <h3 className="text-sm font-medium text-gray-700 dark:text-gray-300 mb-3">
                    Preview
                  </h3>
                  <div className="flex justify-center">
                    <RealisticTshirt
                      color={selectedTshirtColor}
                      type={selectedTshirtType}
                      view={tshirtView}
                      size="small"
                    />
                  </div>
                </div>
              </div>
            )}

            {expandedPanel === "layers" && (
              <div className="space-y-4">
                <div className="flex items-center justify-between">
                  <h3 className="font-medium">
                    Layers ({designElements.length})
                  </h3>
                  <span className="text-xs text-muted-foreground">
                    {designElements.length === 0
                      ? "No layers"
                      : `${designElements.filter((el) => el.visible).length} visible`}
                  </span>
                </div>

                <div className="space-y-2 max-h-96 overflow-y-auto">
                  {designElements.length === 0 ? (
                    <p className="text-sm text-muted-foreground text-center py-8">
                      No elements yet. Add some text, images, or templates!
                    </p>
                  ) : (
                    designElements
                      .slice()
                      .reverse()
                      .map((element) => (
                        <div
                          key={element.id}
                          className={`flex items-center gap-2 p-3 rounded border cursor-pointer transition-colors ${
                            selectedElement === element.id
                              ? "border-primary bg-primary/10"
                              : "border-gray-200 hover:bg-gray-50"
                          }`}
                          onClick={() => setSelectedElement(element.id)}
                        >
                          <Button
                            variant="ghost"
                            size="icon"
                            className="h-6 w-6"
                            onClick={(e) => {
                              e.stopPropagation();
                              toggleElementVisibility(element.id);
                            }}
                          >
                            {element.visible ? (
                              <Eye className="h-3 w-3" />
                            ) : (
                              <EyeOff className="h-3 w-3" />
                            )}
                          </Button>

                          <div className="flex-1 min-w-0">
                            <p className="text-xs font-medium truncate">
                              {element.type === "text" &&
                                `Text: ${element.content?.substring(0, 15) || "Empty"}...`}
                              {element.type === "template" &&
                                `Template: ${element.template?.name}`}
                              {element.type === "image" && "Custom Image"}
                            </p>
                          </div>

                          <div className="flex gap-1">
                            <Button
                              variant="ghost"
                              size="icon"
                              className="h-6 w-6"
                              onClick={(e) => {
                                e.stopPropagation();
                                duplicateElement(element.id);
                              }}
                            >
                              <Copy className="h-3 w-3" />
                            </Button>
                            <Button
                              variant="ghost"
                              size="icon"
                              className="h-6 w-6 text-red-600"
                              onClick={(e) => {
                                e.stopPropagation();
                                deleteElement(element.id);
                              }}
                            >
                              <Trash2 className="h-3 w-3" />
                            </Button>
                          </div>
                        </div>
                      ))
                  )}
                </div>
              </div>
            )}

            {expandedPanel === "text" && (
              <div className="space-y-4">
                <div>
                  <label className="text-sm font-medium mb-2 block">
                    Text Content
                  </label>
                  <Textarea
                    value={textInput}
                    onChange={(e) => setTextInput(e.target.value)}
                    placeholder="Enter your meme text..."
                    rows={3}
                  />
                </div>
                <div className="grid grid-cols-2 gap-3">
                  <div>
                    <label className="text-sm font-medium mb-2 block">
                      Font
                    </label>
                    <select
                      value={textFont}
                      onChange={(e) => setTextFont(e.target.value)}
                      className="w-full bg-input border border-input-border rounded px-3 py-2"
                    >
                      {fonts.map((font) => (
                        <option key={font} value={font}>
                          {font}
                        </option>
                      ))}
                    </select>
                  </div>
                  <div>
                    <label className="text-sm font-medium mb-2 block">
                      Size
                    </label>
                    <Input
                      type="number"
                      value={textSize}
                      onChange={(e) => setTextSize(Number(e.target.value))}
                      min="8"
                      max="72"
                    />
                  </div>
                </div>
                <div>
                  <label className="text-sm font-medium mb-2 block">
                    Color
                  </label>
                  <Input
                    type="color"
                    value={textColor}
                    onChange={(e) => setTextColor(e.target.value)}
                    className="h-10"
                  />
                </div>
                <Button onClick={addTextElement} className="w-full">
                  <Type className="h-4 w-4 mr-2" />
                  Add Text
                </Button>
              </div>
            )}

            {expandedPanel === "stickers" && (
              <div className="space-y-4">
                {/* Search Bar */}
                <div className="relative">
                  <Search className="absolute left-3 top-1/2 transform -translate-y-1/2 h-4 w-4 text-muted-foreground" />
                  <Input
                    placeholder="Search stickers..."
                    value={stickerSearch}
                    onChange={(e) => setStickerSearch(e.target.value)}
                    className="pl-10"
                  />
                </div>

                {/* Sticker Pack Selector */}
                <div className="flex gap-2 overflow-x-auto pb-2">
                  {stickerPacks.map((pack) => (
                    <Button
                      key={pack.id}
                      variant={selectedStickerPack.id === pack.id ? "default" : "outline"}
                      size="sm"
                      onClick={() => setSelectedStickerPack(pack)}
                      className="flex items-center gap-2 whitespace-nowrap"
                    >
                      <span>{pack.icon}</span>
                      <span className="text-xs">{pack.name}</span>
                    </Button>
                  ))}
                </div>

                {/* Stickers Grid */}
                <div className="grid grid-cols-4 gap-2 max-h-80 overflow-y-auto">
                  {selectedStickerPack.stickers
                    .filter(sticker => 
                      stickerSearch === "" || 
                      sticker.name.toLowerCase().includes(stickerSearch.toLowerCase())
                    )
                    .map((sticker) => (
                      <button
                        key={sticker.id}
                        onClick={() => addSticker(sticker)}
                        className="aspect-square p-3 rounded-lg border-2 border-border hover:border-primary hover:bg-primary/10 transition-all flex items-center justify-center text-2xl"
                        title={sticker.name}
                      >
                        {sticker.emoji}
                      </button>
                    ))}
                </div>

                {/* Quick Actions */}
                <div className="flex gap-2">
                  <Button
                    variant="outline"
                    size="sm"
                    onClick={() => {
                      const randomPack = stickerPacks[Math.floor(Math.random() * stickerPacks.length)];
                      const randomSticker = randomPack.stickers[Math.floor(Math.random() * randomPack.stickers.length)];
                      addSticker(randomSticker);
                    }}
                    className="flex-1"
                  >
                    <Star className="h-4 w-4 mr-1" />
                    Random
                  </Button>
                  <Button
                    variant="outline"
                    size="sm"
                    onClick={() => {
                      const popularStickers = [
                        { id: "p1", emoji: "😂", name: "Laughing" },
                        { id: "p2", emoji: "🔥", name: "Fire" },
                        { id: "p3", emoji: "💯", name: "100" },
                      ];
                      const randomSticker = popularStickers[Math.floor(Math.random() * popularStickers.length)];
                      addSticker(randomSticker);
                    }}
                    className="flex-1"
                  >
                    <Heart className="h-4 w-4 mr-1" />
                    Popular
                  </Button>
                </div>
              </div>
            )}

            {expandedPanel === "templates" && (
              <div className="space-y-3">
                {templates.map((template) => (
                  <button
                    key={template.id}
                    onClick={() => addTemplate(template)}
                    className="w-full p-3 glass border border-glass-border rounded-lg hover:bg-hover transition-colors text-left"
                  >
                    <div className="flex items-center gap-3">
                      <span className="text-2xl">{template.preview}</span>
                      <div>
                        <p className="font-medium text-sm">{template.name}</p>
                        <Badge variant="secondary" className="text-xs">
                          {template.category}
                        </Badge>
                      </div>
                    </div>
                  </button>
                ))}
              </div>
            )}

            {expandedPanel === "media" && (
              <div className="space-y-4">
                {/* Media Import Options */}
                <div className="grid grid-cols-2 gap-3">
                  <Button
                    variant="outline"
                    onClick={importFromGallery}
                    className="h-20 flex flex-col items-center justify-center gap-2"
                  >
                    <FileImage className="h-6 w-6" />
                    <span className="text-xs">Gallery</span>
                  </Button>
                  <Button
                    variant="outline"
                    onClick={importFromCamera}
                    className="h-20 flex flex-col items-center justify-center gap-2"
                  >
                    <Camera className="h-6 w-6" />
                    <span className="text-xs">Camera</span>
                  </Button>
                </div>

                {/* Upload Area */}
                <div className="border-2 border-dashed border-border rounded-lg p-6 text-center">
                  <input
                    type="file"
                    ref={fileInputRef}
                    onChange={handleImageUpload}
                    accept="image/*"
                    multiple
                    className="hidden"
                  />
                  <Upload className="h-8 w-8 mx-auto mb-2 text-muted-foreground" />
                  <p className="text-sm text-muted-foreground mb-2">
                    Upload custom images
                  </p>
                  <p className="text-xs text-muted-foreground mb-3">
                    Background removal included
                  </p>
                  <Button
                    variant="outline"
                    size="sm"
                    onClick={() => fileInputRef.current?.click()}
                    disabled={isProcessingImage}
                  >
                    {isProcessingImage ? "Processing..." : "Choose Files"}
                  </Button>
                </div>

                {/* Media Access Info */}
                <div className="bg-blue-50 border border-blue-200 rounded-lg p-3">
                  <div className="flex items-start gap-2">
                    <Folder className="h-4 w-4 text-blue-600 mt-0.5" />
                    <div>
                      <p className="text-sm font-medium text-blue-900">Media Access</p>
                      <p className="text-xs text-blue-700 mt-1">
                        Access your device's photos, WhatsApp stickers, and other media files
                      </p>
                    </div>
                  </div>
                </div>

                {/* Recent Images */}
                {designElements.filter(el => el.type === "image").length > 0 && (
                  <div>
                    <h4 className="text-sm font-medium mb-2">Recent Images</h4>
                    <div className="grid grid-cols-3 gap-2">
                      {designElements
                        .filter(el => el.type === "image")
                        .slice(-6)
                        .map((element) => (
                          <button
                            key={element.id}
                            onClick={() => setSelectedElement(element.id)}
                            className="aspect-square rounded border-2 border-border hover:border-primary transition-colors overflow-hidden"
                          >
                            <img
                              src={element.imageUrl}
                              alt="Recent"
                              className="w-full h-full object-cover"
                            />
                          </button>
                        ))}
                    </div>
                  </div>
                )}
              </div>
            )}

            {expandedPanel === "properties" && (
              <div className="space-y-4">
                {selectedElement ? (
                  (() => {
                    const element = designElements.find(
                      (el) => el.id === selectedElement,
                    );
                    if (!element) return null;

                    return (
                      <>
                        {/* Position Controls */}
                        <div className="space-y-2">
                          <label className="text-sm font-medium">
                            Position
                          </label>
                          <div className="grid grid-cols-2 gap-2">
                            <Input
                              placeholder="X"
                              type="number"
                              value={element.x}
                              onChange={(e) =>
                                updateElement(element.id, {
                                  x: Number(e.target.value),
                                })
                              }
                              className="h-8 text-xs"
                            />
                            <Input
                              placeholder="Y"
                              type="number"
                              value={element.y}
                              onChange={(e) =>
                                updateElement(element.id, {
                                  y: Number(e.target.value),
                                })
                              }
                              className="h-8 text-xs"
                            />
                          </div>
                        </div>

                        {/* Size Controls for images */}
                        {element.type === "image" && (
                          <div className="space-y-2">
                            <label className="text-sm font-medium">Size</label>
                            <div className="grid grid-cols-2 gap-2">
                              <Input
                                placeholder="Width"
                                type="number"
                                value={element.width || 150}
                                onChange={(e) =>
                                  updateElement(element.id, {
                                    width: Number(e.target.value),
                                  })
                                }
                                className="h-8 text-xs"
                              />
                              <Input
                                placeholder="Height"
                                type="number"
                                value={element.height || 150}
                                onChange={(e) =>
                                  updateElement(element.id, {
                                    height: Number(e.target.value),
                                  })
                                }
                                className="h-8 text-xs"
                              />
                            </div>
                          </div>
                        )}

                        {/* Text Properties */}
                        {element.type === "text" && (
                          <>
                            <div className="space-y-2">
                              <label className="text-sm font-medium">
                                Text
                              </label>
                              <Textarea
                                value={element.content || ""}
                                onChange={(e) =>
                                  updateElement(element.id, {
                                    content: e.target.value,
                                  })
                                }
                                className="h-16 text-xs"
                                rows={2}
                              />
                            </div>
                            <div className="space-y-2">
                              <label className="text-sm font-medium">
                                Font
                              </label>
                              <select
                                value={element.font || "Arial"}
                                onChange={(e) =>
                                  updateElement(element.id, {
                                    font: e.target.value,
                                  })
                                }
                                className="w-full bg-input border border-input-border rounded px-2 py-1 text-xs"
                              >
                                {fonts.map((font) => (
                                  <option key={font} value={font}>
                                    {font}
                                  </option>
                                ))}
                              </select>
                            </div>
                            <div className="grid grid-cols-2 gap-2">
                              <div>
                                <label className="text-sm font-medium">
                                  Size
                                </label>
                                <Input
                                  type="number"
                                  value={element.size || 24}
                                  onChange={(e) =>
                                    updateElement(element.id, {
                                      size: Number(e.target.value),
                                    })
                                  }
                                  className="h-8 text-xs"
                                  min="8"
                                  max="72"
                                />
                              </div>
                              <div>
                                <label className="text-sm font-medium">
                                  Color
                                </label>
                                <Input
                                  type="color"
                                  value={element.color || "#000000"}
                                  onChange={(e) =>
                                    updateElement(element.id, {
                                      color: e.target.value,
                                    })
                                  }
                                  className="h-8"
                                />
                              </div>
                            </div>
                          </>
                        )}

                        {/* Common Properties */}
                        <div className="space-y-3">
                          <div>
                            <label className="text-sm font-medium">
                              Rotation: {element.rotation}°
                            </label>
                            <Slider
                              value={[element.rotation]}
                              onValueChange={([value]) =>
                                updateElement(element.id, { rotation: value })
                              }
                              min={0}
                              max={360}
                              step={1}
                              className="mt-1"
                            />
                          </div>

                          <div>
                            <label className="text-sm font-medium">
                              Opacity: {Math.round(element.opacity * 100)}%
                            </label>
                            <Slider
                              value={[element.opacity]}
                              onValueChange={([value]) =>
                                updateElement(element.id, { opacity: value })
                              }
                              min={0}
                              max={1}
                              step={0.01}
                              className="mt-1"
                            />
                          </div>

                          <div className="flex items-center justify-between">
                            <label className="text-sm font-medium">
                              Locked
                            </label>
                            <Switch
                              checked={element.locked}
                              onCheckedChange={(checked) =>
                                updateElement(element.id, { locked: checked })
                              }
                            />
                          </div>
                        </div>
                      </>
                    );
                  })()
                ) : (
                  <p className="text-sm text-muted-foreground">
                    Select an element to edit its properties
                  </p>
                )}
              </div>
            )}
          </div>

          {/* Export Options */}
          <div className="p-4 border-t border-border">
            <div className="space-y-2">
              <Button
                variant="outline"
                className="w-full"
                onClick={exportDesign}
              >
                <Download className="h-4 w-4 mr-2" />
                Download Design
              </Button>
              <Button className="w-full bg-primary hover:bg-primary-hover">
                Add to Cart - TZS {selectedTshirtType.price.toLocaleString()}
              </Button>
            </div>
          </div>
        </div>
      </div>
    );
  }

