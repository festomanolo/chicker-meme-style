import { useState, useRef, useEffect, useCallback } from "react";
import { Button } from "@/components/ui/button";
import { TshirtCanvas } from "@/components/TshirtCanvas";
import { PhotoshopPanel } from "@/components/PhotoshopPanel";
import { WhatsAppNotification } from "@/components/WhatsAppNotification";
import { CropTool } from "@/components/CropTool";
import { DesignElement, HistoryState, TshirtColor, TshirtType, Template, StickerPack } from "@/types/design";
import {
  Undo,
  Redo,
  ZoomIn,
  ZoomOut,
  Save,
  Share2,
  Download,
  Plus,
  X,
} from "lucide-react";

// Import T-shirt components
import TshirtTypeSelector from "../components/tshirt/TshirtTypeSelector";
