    stickers: [
      { id: "m1", emoji: "🐸", name: "Pepe" },
      { id: "m2", emoji: "🤡", name: "Clown" },
      { id: "m3", emoji: "🧠", name: "Big Brain" },
      { id: "m4", emoji: "💀", name: "Skull" },
      { id: "m5", emoji: "🗿", name: "Moai" },
      { id: "m6", emoji: "📈", name: "Stonks" },
      { id: "m7", emoji: "🎪", name: "Circus" },
      { id: "m8", emoji: "🤯", name: "Mind Blown" },
    ]
  },
  {
